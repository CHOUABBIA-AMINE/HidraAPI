# Non-secret production runtime contract for both HidraAPI nodes.
# Secret values are supplied separately through /run/hidra/hidra-secrets.env
# by the approved Vault integration implemented in the deployment HPR.
SPRING_PROFILES_ACTIVE=production
HIDRA_ENVIRONMENT=production
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8080
HIDRA_SECURITY_AUTHENTICATION_MODE=jwt
HIDRA_CORS_ALLOWED_ORIGINS=https://hidra.example.invalid
HIDRA_DATASOURCE_URL=jdbc:postgresql://hidra-postgres.service.invalid:5432/hidra

# P1 keeps local Spring cache only for non-authoritative optimization.
SPRING_CACHE_TYPE=simple
